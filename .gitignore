# Dependencies
node_modules/
.pnpm-store/
__pycache__/
*.pyc
.venv/
venv/
bin/
obj/

# Build outputs
dist/
build/
*.egg-info/

# Environment / secrets — NUNCA versionar
.env
.env.local
.env.*.local
*.pem
*.key

# Dados clínicos/sensíveis — nunca devem existir no repositório (Seção 3.1)
data/patients/
data/phi/
*.dcm.real

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.db
!docs/**/*.db

# Logs
*.log
logs/
!apps/geometry-worker/EVIDENCE_*.log

# Test / coverage
coverage/
.coverage
htmlcov/
.pytest_cache/

# Artefatos de geometria/científicos grandes (versionar via Git LFS ou storage externo, não git)
*.stl
*.3mf
*.vdb
*.vtk
!data/demo/**/*.stl
!apps/web/public/demo-assets/**/*.stl
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.tsbuildinfo

# PicoGK/ImGui grava configuração de layout de janela do viewer neste arquivo ao rodar
# localmente (Incremento 2.1.1, item 10 da correção de calibração) -- é estado local da máquina
# de quem executa o worker, não deve ser versionado.
apps/geometry-worker/imgui.ini

# Armazenamento local transitório de artefatos da API (Incremento 2.1.1) -- criado ao rodar a
# API/worker/seed E2E localmente (config.py: artifact_storage_dir default "./data/artifacts",
# relativo ao cwd de apps/api). NÃO confundir com data/ na raiz do repositório (data/demo/,
# data/schemas/), que são canônicos e versionados -- este padrão é ancorado especificamente em
# apps/api/data/.
apps/api/data/

# Relatorio local do gate final (API->fila->worker PicoGK real->Artifact/Manifest->
# download, apps/api/scripts/verify_full_pipeline_sha256.py) -- evidencia pontual de uma
# execucao especifica, nunca deve ser versionada (o conteudo relevante e transcrito
# manualmente para TEST_EVIDENCE.md/IMPLEMENTATION_STATUS.md quando o usuario roda o gate).
apps/api/GATE_FULL_PIPELINE_REPORT.json

# Transcrição literal de execução real do E2E Playwright no Windows do usuário (redirecionada
# manualmente via PowerShell para evidência, ex.: PLAYWRIGHT_WINDOWS_EVIDENCE_4.txt) -- artefato
# local de evidência pontual, não faz parte do código nem da documentação versionada (o
# conteúdo relevante é transcrito manualmente para TEST_EVIDENCE.md/WORKER_STATUS.md).
PLAYWRIGHT_WINDOWS_EVIDENCE*.txt

# Resultados/relatórios do Playwright (redundante com apps/web/.gitignore, mantido aqui também
# para o caso de a suíte ser executada a partir da raiz do repositório).
test-results/
playwright-report/
blob-report/
playwright/.cache/
