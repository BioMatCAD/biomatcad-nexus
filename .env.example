# Exemplo de variáveis de ambiente — NENHUM SEGREDO REAL AQUI (Seção 26 do Prompt Mestre).
# Copie para .env e preencha localmente. .env nunca deve ser versionado (ver .gitignore).

# --- Ambiente ---
ENVIRONMENT=development        # development | local-network | staging | production | test
# Estados operacionais reais (Incremento 1.1) sao geridos no banco via API, nao por esta
# variavel: research (padrao, sempre habilitado) e laboratory sao contextos independentes;
# clinical_test/clinical_pilot/clinical_production sao a suite clinica, ativada/desativada
# sempre em conjunto via OPERATIONAL_STATE_MASTER_KEY abaixo. Nunca habilitados por padrao.

# --- API (apps/api) ---
# AUTH_MODE atual é DEV_AUTH (e-mail/senha + JWT stateless) — NÃO é OIDC/MFA/WebAuthn.
# Nunca use com dados clínicos reais. Ver docs/adr/0005-classificacao-dev-auth.md.
API_HOST=0.0.0.0
API_PORT=8000
# Obrigatório fora de ENVIRONMENT=test: minimo 32 caracteres, gerado por ferramenta
# criptografica (ex.: `python -c "import secrets; print(secrets.token_urlsafe(48))"`).
# O app RECUSA iniciar fora de development/test/local-network/staging/production com um
# segredo ausente, curto ou igual ao padrão inseguro de desenvolvimento.
API_SECRET_KEY=replace-with-a-real-secret-at-least-32-characters-long

# URL de conexão SQLAlchemy usada de fato por apps/api (SQLite só em development/test).
DATABASE_URL=postgresql://biomatcad:changeme@localhost:5432/biomatcad

# Chave mestra UNICA que ativa/desativa CLINICAL_TEST + CLINICAL_PILOT + CLINICAL_PRODUCTION
# simultaneamente (Incremento 1.1). Sem esta variavel, a suite clinica nunca pode ser
# ativada, inclusive por um administrador. NÃO usar em Pesquisa/Laboratório (contextos
# independentes, sem chave mestra).
OPERATIONAL_STATE_MASTER_KEY=

# --- PostgreSQL (banco principal — Seção 6.2) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=biomatcad
POSTGRES_USER=biomatcad
POSTGRES_PASSWORD=changeme

# --- Redis (cache/locks/fila) ---
REDIS_URL=redis://localhost:6379/0

# --- Object storage (MinIO local, S3-compatível) ---
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_ACCESS_KEY=changeme
OBJECT_STORAGE_SECRET_KEY=changeme
OBJECT_STORAGE_BUCKET=biomatcad-artifacts

# --- IA local (Seção 18.2 — nunca usar provedor externo por padrão) ---
OLLAMA_BASE_URL=http://localhost:11434
LM_STUDIO_BASE_URL=http://localhost:1234

# --- Identity/OIDC (services/identity — módulo PM-ONLY, Fase 1 de fundação) ---
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=

# --- Geometry worker (apps/geometry-worker) ---
GEOMETRY_WORKER_URL=http://localhost:5050

# --- Observabilidade ---
OTEL_EXPORTER_OTLP_ENDPOINT=
